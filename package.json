    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "node tests/e2e/game.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^2.1.8",
    "playwright": "^1.49.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
