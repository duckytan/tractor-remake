{
  "name": "tractor-remake",
  "version": "1.3.43",
  "private": true,
  "type": "module",
  "description": "拖拉机（升级 / 80分）网页重制版 —— 规则引擎 + 单机对 AI",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
